{
  "description": "flow: subagent guards, Codex agent sync, format-on-edit, the plan's test gate, and the /brb cache keepalive",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "commandWindows": "for %P in (py.exe) do @if not \"%~$PATH:P\"==\"\" (py -3 \"%PLUGIN_ROOT%\\hooks\\guard.py\") else (python \"%PLUGIN_ROOT%\\hooks\\guard.py\")"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/codex_agents.py\"",
            "commandWindows": "for %P in (py.exe) do @if not \"%~$PATH:P\"==\"\" (py -3 \"%PLUGIN_ROOT%\\hooks\\codex_agents.py\") else (python \"%PLUGIN_ROOT%\\hooks\\codex_agents.py\")"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/format.py\"",
            "commandWindows": "for %P in (py.exe) do @if not \"%~$PATH:P\"==\"\" (py -3 \"%PLUGIN_ROOT%\\hooks\\format.py\") else (python \"%PLUGIN_ROOT%\\hooks\\format.py\")"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_gate.py\"",
            "commandWindows": "for %P in (py.exe) do @if not \"%~$PATH:P\"==\"\" (py -3 \"%PLUGIN_ROOT%\\hooks\\stop_gate.py\") else (python \"%PLUGIN_ROOT%\\hooks\\stop_gate.py\")",
            "timeout": 660
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/brb.py\" stop",
            "commandWindows": "for %P in (py.exe) do @if not \"%~$PATH:P\"==\"\" (py -3 \"%PLUGIN_ROOT%\\hooks\\brb.py\" stop) else (python \"%PLUGIN_ROOT%\\hooks\\brb.py\" stop)",
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/brb.py\" prompt",
            "commandWindows": "for %P in (py.exe) do @if not \"%~$PATH:P\"==\"\" (py -3 \"%PLUGIN_ROOT%\\hooks\\brb.py\" prompt) else (python \"%PLUGIN_ROOT%\\hooks\\brb.py\" prompt)"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/brb.py\" expand",
            "commandWindows": "for %P in (py.exe) do @if not \"%~$PATH:P\"==\"\" (py -3 \"%PLUGIN_ROOT%\\hooks\\brb.py\" expand) else (python \"%PLUGIN_ROOT%\\hooks\\brb.py\" expand)"
          }
        ]
      }
    ]
  }
}
