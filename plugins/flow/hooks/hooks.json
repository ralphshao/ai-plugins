{
  "description": "flow: subagent guards, Codex agent sync, format-on-edit, and the plan's test gate",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\guard.py\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/codex_agents.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\codex_agents.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/format.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\format.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_gate.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\stop_gate.py\"",
            "timeout": 660
          }
        ]
      }
    ]
  }
}
